# GEMINI_API_KEY: Required only if Gemini AI API calls are added in the future.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ORDER_SIGNING_SECRET: Wajib disetel di Secrets / environment server produksi
# Gunakan string acak minimal 32 karakter (contoh: hasil openssl rand -hex 32)
# agar verifikasi tanda tangan HMAC pesanan konsisten setelah server restart/redeploy.
ORDER_SIGNING_SECRET=

# OBJECT_STORAGE_* (Opsional untuk mode produksi persisten tanpa kartu pembayaran:
# Gunakan Supabase Storage S3 Free Plan 1 GB gratis tanpa kartu kredit, atau biarkan kosong untuk mode preview lokal)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
