rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'akunob300@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdminEmail() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
        'id', 'title', 'slug', 'category', 'price',
        'shortDescription', 'fullDescription', 'coverUrl',
        'active', 'featured', 'isDemo', 'hasPrivateFile',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'slug', 'category', 'price', 'targetAudience',
        'shortDescription', 'fullDescription', 'benefits', 'contents',
        'coverUrl', 'active', 'featured', 'isDemo', 'hasPrivateFile',
        'source', 'createdAt', 'updatedAt'
      ]) &&
      data.id == productId &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
      data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 180 &&
      data.category in ['E-book', 'Template Website', 'Template Bisnis', 'Panduan Praktis', 'Produk Edukasi', 'Cerita Anak', 'Karya Digital'] &&
      (data.price is int || data.price is float) && data.price >= 0 && data.price <= 100000000 &&
      (!('targetAudience' in data) || (data.targetAudience is string && data.targetAudience.size() <= 100)) &&
      data.shortDescription is string && data.shortDescription.size() >= 5 && data.shortDescription.size() <= 320 &&
      data.fullDescription is string && data.fullDescription.size() >= 5 && data.fullDescription.size() <= 4000 &&
      (!('benefits' in data) || (data.benefits is list && data.benefits.size() <= 15 && (data.benefits.size() == 0 || data.benefits[0] is string))) &&
      (!('contents' in data) || (data.contents is list && data.contents.size() <= 20 && (data.contents.size() == 0 || data.contents[0] is string))) &&
      data.coverUrl is string && data.coverUrl.size() <= 1000 &&
      data.active is bool &&
      data.featured is bool &&
      data.isDemo is bool &&
      data.hasPrivateFile is bool &&
      (!('source' in data) || data.source in ['firestore', 'sheets_import']) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidProductFile(data, productId) {
      return data.keys().hasAll(['productId', 'fileId', 'fileName', 'mimeType', 'sizeBytes', 'updatedAt']) &&
        data.keys().hasOnly(['productId', 'fileId', 'fileName', 'mimeType', 'sizeBytes', 'updatedAt']) &&
        data.productId == productId &&
        data.fileId is string && data.fileId.size() >= 1 && data.fileId.size() <= 256 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 256 &&
        data.mimeType is string && data.mimeType.size() <= 120 &&
        (data.sizeBytes is int || data.sizeBytes is float) && data.sizeBytes >= 0 && data.sizeBytes <= 104857600 &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
        'orderCode', 'buyerUid', 'customerName', 'customerEmail',
        'customerWhatsapp', 'paymentMethod', 'items', 'subtotal',
        'totalAmount', 'status', 'accessKeyHash', 'serverSignature',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderCode', 'buyerUid', 'customerName', 'customerEmail',
        'customerWhatsapp', 'paymentMethod', 'items', 'subtotal',
        'totalAmount', 'status', 'accessKeyHash', 'serverSignature',
        'adminNote', 'createdAt', 'updatedAt'
      ]) &&
      data.orderCode == orderId &&
      data.buyerUid is string && data.buyerUid.size() >= 1 && data.buyerUid.size() <= 128 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
      data.customerEmail is string && data.customerEmail.size() >= 5 && data.customerEmail.size() <= 180 &&
      data.customerWhatsapp is string && data.customerWhatsapp.size() >= 8 && data.customerWhatsapp.size() <= 30 &&
      data.paymentMethod in ['Transfer Bank', 'QRIS'] &&
      data.items is list && data.items.size() >= 1 && data.items.size() <= 20 && data.items[0] is map &&
      (data.subtotal is int || data.subtotal is float) && data.subtotal > 0 && data.subtotal <= 500000000 &&
      (data.totalAmount is int || data.totalAmount is float) && data.totalAmount > 0 && data.totalAmount <= 500000000 &&
      data.status in ['Menunggu Pembayaran', 'Menunggu Verifikasi', 'Dibayar', 'Ditolak', 'Selesai', 'Dibatalkan'] &&
      data.accessKeyHash is string && data.accessKeyHash.size() >= 16 && data.accessKeyHash.size() <= 128 &&
      data.serverSignature is string && data.serverSignature.size() >= 16 && data.serverSignature.size() <= 128 &&
      (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidOrderReceipt(data, orderCode) {
      return data.keys().hasAll([
        'orderCode', 'status', 'paymentMethod', 'subtotal',
        'totalAmount', 'itemSummaries', 'accessKeyHash',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderCode', 'status', 'paymentMethod', 'subtotal',
        'totalAmount', 'itemSummaries', 'accessKeyHash',
        'proofUrl', 'downloadGrants', 'adminNote',
        'createdAt', 'updatedAt'
      ]) &&
      data.orderCode == orderCode &&
      data.status in ['Menunggu Pembayaran', 'Menunggu Verifikasi', 'Dibayar', 'Ditolak', 'Selesai', 'Dibatalkan'] &&
      data.paymentMethod in ['Transfer Bank', 'QRIS'] &&
      (data.subtotal is int || data.subtotal is float) && data.subtotal > 0 && data.subtotal <= 500000000 &&
      (data.totalAmount is int || data.totalAmount is float) && data.totalAmount > 0 && data.totalAmount <= 500000000 &&
      data.itemSummaries is list && data.itemSummaries.size() >= 1 && data.itemSummaries.size() <= 20 && data.itemSummaries[0] is map &&
      data.accessKeyHash is string && data.accessKeyHash.size() >= 16 && data.accessKeyHash.size() <= 128 &&
      (!('proofUrl' in data) || (data.proofUrl is string && data.proofUrl.size() <= 500)) &&
      (!('downloadGrants' in data) || (data.downloadGrants is list && data.downloadGrants.size() <= 20 && (data.downloadGrants.size() == 0 || data.downloadGrants[0] is map))) &&
      (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidDownloadToken(data, tokenId) {
      return data.keys().hasAll(['tokenId', 'orderCode', 'productId', 'productTitle', 'fileId', 'fileName', 'enabled', 'createdAt']) &&
        data.keys().hasOnly(['tokenId', 'orderCode', 'productId', 'productTitle', 'fileId', 'fileName', 'enabled', 'createdAt']) &&
        data.tokenId == tokenId &&
        isValidId(data.orderCode) &&
        isValidId(data.productId) &&
        data.productTitle is string && data.productTitle.size() >= 1 && data.productTitle.size() <= 180 &&
        data.fileId is string && data.fileId.size() >= 1 && data.fileId.size() <= 256 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 256 &&
        data.enabled is bool &&
        data.createdAt is timestamp;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll(['id', 'customerName', 'rating', 'comment', 'dateLabel', 'visible', 'isDemo', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'customerName', 'roleOrCity', 'avatarUrl', 'rating', 'comment', 'dateLabel', 'visible', 'isDemo', 'createdAt', 'updatedAt']) &&
        data.id == reviewId &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        (!('roleOrCity' in data) || (data.roleOrCity is string && data.roleOrCity.size() <= 100)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        (data.rating is int || data.rating is float) && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1000 &&
        data.dateLabel is string && data.dateLabel.size() >= 2 && data.dateLabel.size() <= 60 &&
        data.visible is bool &&
        data.isDemo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
        'storeName', 'tagline', 'heroTitle', 'heroDescription',
        'whatsappNumber', 'contactEmail', 'bankName',
        'bankAccountNumber', 'bankAccountHolder', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'storeName', 'tagline', 'heroTitle', 'heroDescription',
        'promoText', 'showPromo', 'logoUrl', 'bannerUrl',
        'watermarkUrl', 'faviconUrl', 'qrisUrl', 'whatsappNumber',
        'contactEmail', 'bankName', 'bankAccountNumber',
        'bankAccountHolder', 'paymentInstructions',
        'footerDescription', 'footerCopyright', 'updatedAt'
      ]) &&
      data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
      data.tagline is string && data.tagline.size() <= 180 &&
      data.heroTitle is string && data.heroTitle.size() <= 160 &&
      data.heroDescription is string && data.heroDescription.size() <= 500 &&
      (!('promoText' in data) || (data.promoText is string && data.promoText.size() <= 200)) &&
      (!('showPromo' in data) || data.showPromo is bool) &&
      (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500)) &&
      (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 500)) &&
      (!('watermarkUrl' in data) || (data.watermarkUrl is string && data.watermarkUrl.size() <= 500)) &&
      (!('faviconUrl' in data) || (data.faviconUrl is string && data.faviconUrl.size() <= 500)) &&
      (!('qrisUrl' in data) || (data.qrisUrl is string && data.qrisUrl.size() <= 500)) &&
      data.whatsappNumber is string && data.whatsappNumber.size() <= 30 &&
      data.contactEmail is string && data.contactEmail.size() <= 160 &&
      data.bankName is string && data.bankName.size() <= 80 &&
      data.bankAccountNumber is string && data.bankAccountNumber.size() <= 60 &&
      data.bankAccountHolder is string && data.bankAccountHolder.size() <= 120 &&
      (!('paymentInstructions' in data) || (data.paymentInstructions is string && data.paymentInstructions.size() <= 1000)) &&
      (!('footerDescription' in data) || (data.footerDescription is string && data.footerDescription.size() <= 400)) &&
      (!('footerCopyright' in data) || (data.footerCopyright is string && data.footerCopyright.size() <= 160)) &&
      data.updatedAt is timestamp;
    }

    // 3. Connection Test Document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // 4. Admins Collection
    match /admins/{uid} {
      allow get: if isValidId(uid) && isVerifiedUser() && (request.auth.uid == uid || isAdmin());
      allow list: if isBootstrapAdminEmail();
      allow create, update: if isValidId(uid) && isBootstrapAdminEmail() &&
        incoming().keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        incoming().keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        incoming().uid == uid &&
        incoming().email is string && incoming().email.size() <= 200 &&
        incoming().role in ['admin', 'superadmin'];
      allow delete: if isValidId(uid) && isBootstrapAdminEmail();
    }

    // 5. Public Digital Catalog (No private file URLs stored here)
    match /products/{productId} {
      allow get: if isValidId(productId) && (resource == null || existing().active == true || isAdmin());
      allow list: if existing().active == true || isBootstrapAdminEmail();
      allow create: if isValidId(productId) && isAdmin() &&
        isValidProduct(incoming(), productId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isAdmin() &&
        isValidProduct(incoming(), productId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    // 6. Private Product File Metadata (Admin Only)
    match /product_files/{productId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(productId) && isAdmin() &&
        isValidProductFile(incoming(), productId) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    // 7. Customer Orders (PII Protected)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerifiedUser() && existing().buyerUid == request.auth.uid));
      allow list: if isBootstrapAdminEmail() || (isVerifiedUser() && existing().buyerUid == request.auth.uid);
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().status == 'Menunggu Pembayaran' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ((isSignedIn() && incoming().buyerUid == request.auth.uid) || (!isSignedIn() && incoming().buyerUid == 'guest'));
      allow update: if isValidId(orderId) && isAdmin() &&
        isValidOrder(incoming(), orderId) &&
        incoming().orderCode == existing().orderCode &&
        incoming().buyerUid == existing().buyerUid &&
        incoming().accessKeyHash == existing().accessKeyHash &&
        incoming().serverSignature == existing().serverSignature &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 8. Non-PII Order Receipts (Single-doc lookup by unique orderCode)
    match /order_receipts/{orderCode} {
      allow get: if isValidId(orderCode);
      allow list: if false;
      allow create: if isValidId(orderCode) &&
        isValidOrderReceipt(incoming(), orderCode) &&
        incoming().status == 'Menunggu Pembayaran' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(orderCode) &&
        isValidOrderReceipt(incoming(), orderCode) &&
        incoming().orderCode == existing().orderCode &&
        incoming().accessKeyHash == existing().accessKeyHash &&
        incoming().subtotal == existing().subtotal &&
        incoming().totalAmount == existing().totalAmount &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().status == 'Menunggu Pembayaran' &&
            (!('proofUrl' in existing()) || existing().proofUrl == '') &&
            incoming().status == 'Menunggu Verifikasi' &&
            incoming().proofUrl is string &&
            incoming().proofUrl.size() <= 160 &&
            incoming().proofUrl.matches('^/api/proofs/proof_[a-zA-Z0-9_\\-]+\\.(jpg|jpeg|png|webp|pdf)$') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['proofUrl', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(orderCode) && isAdmin();
    }

    // 9. Secure Download Tokens (Admin-minted, non-PII, single-doc get only)
    match /download_tokens/{tokenId} {
      allow get: if isValidId(tokenId);
      allow list: if false;
      allow create: if isValidId(tokenId) && isAdmin() &&
        isValidDownloadToken(incoming(), tokenId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(tokenId) && isAdmin() &&
        isValidDownloadToken(incoming(), tokenId) &&
        incoming().tokenId == existing().tokenId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(tokenId) && isAdmin();
    }

    // 10. Customer Reviews
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (resource == null || existing().visible == true || isAdmin());
      allow list: if existing().visible == true || isBootstrapAdminEmail();
      allow create: if isValidId(reviewId) && isAdmin() &&
        isValidReview(incoming(), reviewId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(reviewId) && isAdmin() &&
        isValidReview(incoming(), reviewId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // 11. Store Settings & Appearance
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId in ['store'];
      allow list: if false;
      allow create, update: if isValidId(settingId) && settingId in ['store'] &&
        isAdmin() &&
        isValidStoreSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
